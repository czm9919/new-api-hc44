# 复制成 .env 后按需修改：cp .env.example .env
#
# SESSION_SECRET 必填，用下面任一命令生成（32 字节随机）：
#   openssl rand -base64 32
#   head -c 32 /dev/urandom | base64
SESSION_SECRET=

# 镜像标签：升级时换成新版本号即可
IMAGE=delta-api/new-api:v1.0.0-rc.43-hc12

# 监听地址：默认只给反代用；没有反代要直接对外时改成 0.0.0.0
BIND_ADDR=127.0.0.1
HOST_PORT=3000

NODE_NAME=new-api-node-1

# 配好 HTTPS 反代之后改成 true，否则浏览器不会带 Cookie
SESSION_COOKIE_SECURE=false
